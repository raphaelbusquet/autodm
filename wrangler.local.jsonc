{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autodm-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ],
  // No service bindings: local tasks use the inline fallback.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autodm",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "CONTACT_EMAIL": "you@example.com" }
}
