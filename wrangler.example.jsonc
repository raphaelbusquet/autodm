{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autodm",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ],
  "services": [
    // Keep service equal to this Worker's name if you rename it.
    { "binding": "SELF", "service": "autodm" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autodm",
      // Replace with YOUR ID from: npx wrangler d1 create autodm
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "CONTACT_EMAIL": "you@example.com" }
  // Secrets: ADMIN_PASSWORD, IG_APP_ID, IG_APP_SECRET, META_APP_SECRET,
  // IG_VERIFY_TOKEN, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.
  // Optional ebook integration: see README.
}
